<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="hotel_homepage" name="Hotel Homepage">

        <t t-call="website.layout">

            <head>
                <link rel="stylesheet"
                      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"/>

                <link rel="stylesheet"
                      type="text/css"
                      href="/hotel_erp/static/src/css/hotel_theme.css"/>
            </head>

            <div id="wrap" class="hx-page oe_structure oe_empty">

                <!-- ================= HERO ================= -->

                <section class="hx-hero">

                    <t t-set="hero_rooms" t-value="rooms[:5]"/>

                    <div id="hotelHeroCarousel"
                         class="carousel slide carousel-fade"
                         data-bs-ride="carousel"
                         data-bs-interval="5000">

                        <!-- SLIDES -->

                        <div class="carousel-inner">

                            <t t-if="hero_rooms">

                                <t t-foreach="hero_rooms" t-as="r">

                                    <div t-attf-class="carousel-item #{'active' if r_index == 0 else ''}">

                                        <t t-if="r.image_1920">

                                            <img t-attf-src="/web/image/hotel.room/#{r.id}/image_1920"
                                                 t-att-alt="r.room_number"/>

                                        </t>

                                        <t t-elif="r.image_ids">

                                            <img t-attf-src="/web/image/hotel.room.images/#{r.image_ids[0].id}/image_1920"
                                                 t-att-alt="r.room_number"/>

                                        </t>

                                    </div>

                                </t>

                            </t>

                            <t t-else="">

                                <div class="carousel-item active">
                                    <div class="hx-card-ph">
                                        <i class="fa fa-bed"/>
                                    </div>
                                </div>

                            </t>

                        </div>

                        <!-- CONTROLS -->

                        <t t-if="len(hero_rooms) &gt; 1">

                            <button class="carousel-control-prev"
                                    type="button"
                                    data-bs-target="#hotelHeroCarousel"
                                    data-bs-slide="prev"
                                    aria-label="Previous slide">

                                <span class="carousel-control-prev-icon"
                                      aria-hidden="true"/>

                            </button>

                            <button class="carousel-control-next"
                                    type="button"
                                    data-bs-target="#hotelHeroCarousel"
                                    data-bs-slide="next"
                                    aria-label="Next slide">

                                <span class="carousel-control-next-icon"
                                      aria-hidden="true"/>

                            </button>

                        </t>

                    </div>

                    <!-- HERO TEXT -->

                    <div class="hx-hero-copy">

                        <h1>Stay somewhere you will remember</h1>

                        <p>
                            Quiet rooms, warm service, and a bed you will not want to leave.
                        </p>

                        <div class="d-flex flex-wrap gap-3">

                            <a href="/rooms"
                               class="hx-btn hx-btn-gold">
                                Book a room
                            </a>

                            <a href="#hx_rooms"
                               class="hx-btn hx-btn-ghost">
                                View rooms
                            </a>

                        </div>

                    </div>

                </section>


                <!-- ================= AVAILABILITY BAR ================= -->

                <form action="/rooms"
                      method="get"
                      class="hx-search">

                    <div class="hx-field">

                        <label for="hx_in">CHECK-IN</label>

                        <input type="text"
                               id="hx_in"
                               name="check_in"
                               placeholder="Select date"
                               autocomplete="off"
                               required="1"/>

                    </div>

                    <div class="hx-field">

                        <label for="hx_out">CHECK-OUT</label>

                        <input type="text"
                               id="hx_out"
                               name="check_out"
                               placeholder="Select date"
                               autocomplete="off"
                               required="1"/>

                    </div>

                    <button type="submit"
                            class="hx-btn hx-btn-gold">

                        <i class="fa fa-search"/>
                        Search

                    </button>

                </form>


                <!-- ================= ROOMS ================= -->

                <section class="hx-section" id="hx_rooms">

                    <div class="hx-container">

                        <div class="mb-5">

                            <div class="hx-eyebrow">
                                ACCOMMODATION
                            </div>

                            <h2 class="hx-title">
                                Our rooms
                            </h2>

                            <p class="hx-sub">
                                Choose the room that fits your stay.
                            </p>

                        </div>

                        <div class="hx-grid">

                            <t t-foreach="rooms[:6]" t-as="room">

                                <t t-call="hotel_erp.hotel_room_card">

                                    <t t-set="r" t-value="room"/>

                                </t>

                            </t>

                        </div>

                    </div>

                </section>


                <!-- ================= AMENITIES ================= -->

                <section class="hx-amen">

                    <div class="hx-container">

                        <div class="hx-amen-grid">

                            <div class="hx-amen-item">

                                <i class="fa fa-wifi"/>

                                <h5>Free high-speed Wi-Fi</h5>

                                <p>
                                    Stay connected everywhere in the hotel.
                                </p>

                            </div>

                            <div class="hx-amen-item">

                                <i class="fa fa-coffee"/>

                                <h5>Daily breakfast</h5>

                                <p>
                                    Fresh buffet breakfast, every morning.
                                </p>

                            </div>

                            <div class="hx-amen-item">

                                <i class="fa fa-life-ring"/>

                                <h5>Swimming pool</h5>

                                <p>
                                    A temperature-controlled pool to unwind.
                                </p>

                            </div>

                            <div class="hx-amen-item">

                                <i class="fa fa-bell"/>

                                <h5>24/7 room service</h5>

                                <p>
                                    Our team is here around the clock.
                                </p>

                            </div>

                        </div>

                    </div>

                </section>

            </div>


            <!-- ================= FLATPICKR ================= -->

            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

            <script>
                document.addEventListener("DOMContentLoaded", function () {

                    if (!window.flatpickr || !document.getElementById("hx_in")) {
                        return;
                    }

                    var out = flatpickr("#hx_out", {
                        minDate: "today",
                        dateFormat: "Y-m-d"
                    });

                    flatpickr("#hx_in", {

                        minDate: "today",
                        dateFormat: "Y-m-d",

                        onChange: function (d) {

                            if (d.length) {

                                var n = new Date(d[0]);

                                n.setDate(n.getDate() + 1);

                                out.set("minDate", n);

                                out.open();

                            }

                        }

                    });

                });
            </script>

        </t>

    </template>

</odoo>
