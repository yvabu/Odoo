<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="hotel_room_details_page" name="Room Details Page">
        <t t-call="website.layout">

            <head>
                <link rel="stylesheet"
                      type="text/css"
                      href="/hotel_erp/static/src/css/hotel_theme.css"/>
            </head>

            <t t-set="total_imgs"
               t-value="(1 if room.image_1920 else 0) + len(room.image_ids)"/>
            <t t-set="check_in" t-value="request.params.get('check_in') or check_in or ''"/>
            <t t-set="check_out" t-value="request.params.get('check_out') or check_out or ''"/>
            <div id="wrap" class="hx-page oe_structure oe_empty">

                <div class="hx-container"
                     style="padding-top:32px;padding-bottom:72px">


                    <!-- BREADCRUMB -->
                    <nav aria-label="breadcrumb"
                         class="mb-4 small text-muted">

                        <a href="/"
                           class="text-muted text-decoration-none">
                            Home
                        </a>

                        /

                        <a href="/rooms"
                           class="text-muted text-decoration-none">
                            Rooms
                        </a>

                        /

                        <span class="text-dark">
                            Room
                            <t t-out="room.room_number"/>
                        </span>

                    </nav>


                    <div class="hx-detail">


                        <!-- LEFT: GALLERY + INFO -->
                        <div>

                            <!-- ROOM IMAGE CAROUSEL -->
                            <div id="roomDetailsCarousel"
                                 class="carousel slide hx-gallery"
                                 data-bs-ride="carousel"
                                 data-bs-interval="5000">

                                <!-- SLIDES -->
                                <div class="carousel-inner">

                                    <!-- MAIN IMAGE -->
                                    <t t-if="room.image_1920">

                                        <div class="carousel-item active h-100">

                                            <img t-attf-src="/web/image/hotel.room/#{room.id}/image_1920"
                                                 t-att-alt="room.room_number"/>

                                        </div>

                                    </t>


                                    <!-- ADDITIONAL IMAGES -->
                                    <t t-foreach="room.image_ids" t-as="img">

                                        <div t-attf-class="carousel-item h-100 #{'active' if (not room.image_1920 and img_index == 0) else ''}">

                                            <img t-attf-src="/web/image/hotel.room.images/#{img.id}/image_1920"/>

                                        </div>

                                    </t>


                                    <!-- NO IMAGES -->
                                    <t t-if="total_imgs == 0">

                                        <div class="carousel-item active h-100">

                                            <div class="hx-card-ph">
                                                <i class="fa fa-bed"/>
                                            </div>

                                        </div>

                                    </t>

                                </div>


                                <!-- CAROUSEL CONTROLS -->
                                <t t-if="total_imgs &gt; 1">

                                    <button class="carousel-control-prev"
                                            type="button"
                                            data-bs-target="#roomDetailsCarousel"
                                            data-bs-slide="prev"
                                            aria-label="Previous image">

                                        <span class="carousel-control-prev-icon"
                                              aria-hidden="true"></span>

                                    </button>


                                    <button class="carousel-control-next"
                                            type="button"
                                            data-bs-target="#roomDetailsCarousel"
                                            data-bs-slide="next"
                                            aria-label="Next image">

                                        <span class="carousel-control-next-icon"
                                              aria-hidden="true"></span>

                                    </button>

                                </t>

                            </div>


                            <!-- ROOM INFORMATION -->
                            <div class="mt-4">

                                <div class="hx-eyebrow">
                                    <t t-out="room.room_type"/>
                                </div>

                                <h1 class="hx-title">
                                    Room
                                    <t t-out="room.room_number"/>
                                </h1>


                                <p t-if="room.description"
                                   class="text-muted"
                                   style="line-height:1.8"
                                   t-out="room.description"/>


                                <!-- FEATURES -->
                                <div class="hx-feats">

                                    <div class="hx-feat">

                                        <i class="fa fa-users"/>

                                        <span>
                                            <t t-out="room.capacity"/>
                                            guests
                                        </span>

                                    </div>


                                    <div class="hx-feat"
                                         t-if="room.is_wifi">

                                        <i class="fa fa-wifi"/>

                                        <span>Free Wi-Fi</span>

                                    </div>


                                    <div class="hx-feat">

                                        <i class="fa fa-tv"/>

                                        <span>Smart TV</span>

                                    </div>


                                    <div class="hx-feat"
                                         t-if="room.is_air_conditioning">

                                        <i class="fa fa-snowflake-o"/>

                                        <span>Air conditioning</span>

                                    </div>


                                    <div class="hx-feat"
                                         t-if="room.balcony_count">

                                        <i class="fa fa-window-maximize"/>

                                        <span>
                                            <t t-out="room.balcony_count"/>
                                            balcony
                                        </span>

                                    </div>


                                    <div class="hx-feat"
                                         t-if="room.is_smoking">

                                        <i class="fa fa-fire"/>

                                        <span>Smoking available</span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- RIGHT: BOOKING CARD -->
                        <aside class="hx-book">

                            <div class="hx-price mb-3">

                                <b>
                                    $
                                    <t t-out="room.room_price"/>
                                </b>

                                <span>/ night</span>

                            </div>


                            <t t-if="check_in and check_out">

                                <div class="mb-3 small text-muted">

                                    <i class="fa fa-calendar me-1"
                                       style="color:var(--hx-gold-d)"/>

                                    <t t-out="check_in"/>

                                    →

                                    <t t-out="check_out"/>

                                </div>

                            </t>


                            <!-- BOOK BUTTON -->
                            <a t-attf-href="/booking?room_id=#{room.id}&amp;check_in=#{check_in}&amp;check_out=#{check_out}"
                               class="hx-btn hx-btn-gold w-100">

                                Book this room

                            </a>


                            <div class="small text-muted mt-3">

                                <i class="fa fa-shield me-1"
                                   style="color:var(--hx-gold-d)"/>

                                You will confirm the dates at the next stage.

                            </div>

                        </aside>


                    </div>

                </div>

            </div>

        </t>
    </template>
</odoo>
