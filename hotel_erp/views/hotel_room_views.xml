<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!-- kanban view -->
   <record id="hotel_room_kanban_view" model="ir.ui.view">
       <field name="name">hotel.room.kanban.view</field>
       <field name="model">hotel.room</field>
       <field name="arch" type="xml">
           <kanban default_group_by="room_status" quick_create="false">
               <field name="id"/>
               <field name="room_number"/>
               <field name="room_type"/>
               <field name="capacity"/>
               <field name="room_price"/>
               <field name="room_status"/>
               <field name="housekeeping_status"/>
               <templates>
               <t t-name="kanban-box">
                   <div class="oe_kanban_global_click">
                       <div class="oe_kanban_details">
                           <strong class="o_kanban_record_title">
                               <span>ოთახი N:<field name="room_number"/></span>
                           </strong>
                           <div>
                               <span>ტიპი:<field name="room_type"/></span>
                           </div>
                           <div>
                               <span>ტევადობა:<field name="capacity"/></span>
                           </div>
                           <div>
                               <span>ფასი:<field name="room_price" widget="monetary"/></span>
                           </div>
                           <div class="mt-1">
                               <field name="room_status" widget="badge"
                                      decoration-success="room_status == 'available'"
                                      decoration-danger="room_status =='occupied'"
                                      decoration-warning="room_status == 'maintenance'"/>
                           </div>
                           <div class="mt-1">
                               <field name="housekeeping_status" widget="badge" bagde-success="housekeeping_status=='clean'" badge-danger="housekeeping_status=='dirty'" badge-warning="housekeeping_status='maintenance'"/>
                           </div>
                       </div>
                   </div>
               </t>
               </templates>
           </kanban>
       </field>
   </record>
<!--tree view-->
    <record id="hotel_room_tree_view" model="ir.ui.view">
        <field name="name">hotel.room.tree.view</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="room_number"/>
                <field name="room_type"/>
                <field name="room_price"/>
                <field name="room_status" widget="badge" decoration-success="room_status == 'available'" decoration-danger="room_status =='occupied'" decoration-warning="room_status == 'maintenance'"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="housekeeping_status" decoration-success="housekeeping_status=='clean'" decoration-warning="housekeeping_status=='maintenance'" decoration-danger="housekeeping_status=='dirty'"/>
            </list>
        </field>
    </record>
<!--form view-->
    <record id="hotel_room_form_view" model="ir.ui.view">
        <field name="name">hotel.room.form.view</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <header>
                   <button name="action_set_available" string="Set Available" type="object" class="oe_highlight" invisible="room_status !='maintenance'"/>
                   <button name="action_set_maintenance" string="Set Maintenance" type="object" class="oe_highlight" invisible="room_status !='available'"/>
                   <button name="action_copy_room" string="Copy room" type="object" class="oe_highlight"/>
                   <button name="action_set_clean" string="Set Clean" type="object" class="btn-primary"/>
                   <button name="action_set_dirty" string="Set Dirty" type="object" class="btn-primary"/>
                   <button name="action_set_status_maintenance" string="Set House Status Maintenance" type="object" class="btn-primary"/>


                    <field name="room_status" widget="statusbar" statusbar_visible="available,occupied,maintenance"/>
                    <field name="housekeeping_status" widget="statusbar" statusbar_visible="clean,dirty,inspection,maintenance"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reservation" type="object" class="oe_stat_button" icon="fa-bed">
                            <field name="reservation_count" widget="statinfo" string="Reservations"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>

                <div class="oe_title">
                  <label for="room_number"/>
                    <h1>
                        <field name="room_number" placeholder="enter room number"/>
                    </h1>
                </div>
                <group>
                     <group>
                       <field name="room_type"/>
                       <field name="room_price"/>
                       <field name="floor"/>
                       <field name="capacity"/>
                     </group>
                     <group>
                       <field name="room_status"/>
                       <field name="active" widget="boolean_toggle"/>
                     </group>
                </group>
                <notebook>
                    <page string="Mosanishnebi" name="mosanishnebi">
                      <group>
                          <group>
                              <field name="is_wifi"/>
                              <field name="is_air_conditioning"/>
                          </group>
                          <group>
                              <field name="is_smoking"/>
                              <field name="balcony_count"/>
                          </group>
                      </group>
                    </page>
                    <page string="description" name="description">
                        <field name="description" placeholder="Room details.."/>
                    </page>

                    <page string="Room Reservation" name="reservation">
                        <field name="reservation_ids">
                            <form>
                               <header>
                                   <button name="action_confirm" string="Set Confirm" type="object" class="oe_highlight" invisible="state !='draft'"/>
                                   <button name="action_cancel" string="Set Cancel" type="object" invisible="state =='cancelled'"/>

                                   <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                               </header>
                                <group>
                                    <group>
                                        <field name="name" readonly="1"/>
                                        <field name="guest_id"/>
                                        <field name="room_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="check_in"/>
                                        <field name="check_out"/>
                                        <field name="total_price" readonly="1"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </page>
                </notebook>
                </sheet>
            </form>
        </field>
    </record>
<!-- search view-->
    <record id="hotel_room_search_view" model="ir.ui.view">
        <field name="name">hotel.room.search.view</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_number" filter_domain="['|',('room_number','ilike',self),('room_type','ilike',self)]"/>
                <field name="room_type"/>

                <filter name="available_rooms" string="Available Rooms" domain="[('room_status','=','available')]"/>
                <filter name="vip_rooms" string="VIP Rooms" domain="[('room_type','=','vip')]"/>

                <filter name="clean_rooms" string="Clean Rooms" domain="[('housekeeping_status','=','clean')]"/>
                <filter name="dirty_rooms" string="Dirty Rooms" domain="[('housekeeping_status','=','dirty')]"/>


                <group expand="0" string="Group By">
                    <filter name="group_by_room_type" string="Room Type" context="{'group_by':'room_type'}"/>
                    <filter name="group_by_floor" string="Floor" context="{'group_by':'floor'}"/>
                    <filter name="group_by_house_status" string="HouseKeeping Status" context="{'group_by':'housekeeping_status'}"/>
                </group>
            </search>
        </field>
    </record>
<!--window action-->
    <record id="hotel_room_window_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>