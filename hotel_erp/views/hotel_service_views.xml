<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--list view -->
    <record id="hotel_service_tree_view" model="ir.ui.view">
        <field name="name">hotel.service.tree.view</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="service_type"/>
                <field name="price"/>
                <field name="active"/>
            </list>
        </field>
    </record>
<!--form view -->
    <record id="hotel_service_form_view" model="ir.ui.view">
        <field name="name">hotel.service.form.view</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                 <group>
                    <group>
                        <field name="name"/>
                        <field name="service_type"/>
                    </group>
                    <group>
                        <field name="price"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                 </group>
                    <notebook>
                     <page name="description" string="Description">
                       <group>
                           <field name="description" placeholder="Enter Description...."/>
                       </group>
                     </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
<!-- search view -->
        <record id="hotel_service_search_view" model="ir.ui.view">
            <field name="name">hotel.service.search.view</field>
            <field name="model">hotel.service</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="archived_services" string="Archived Services" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>
<!--window action-->
    <record id="hotel_service_window_action" model="ir.actions.act_window">
        <field name="name">Hotel Service</field>
        <field name="res_model">hotel.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>