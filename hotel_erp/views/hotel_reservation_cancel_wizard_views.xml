<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hotel_reservation_cancel_wizrd_view" model="ir.ui.view">
        <field name="name">hotel.reservation.cancel_wizard_view</field>
        <field name="model">hotel.reservation.cancel.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="paid_amount" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="paid_amount &lt;= 0">
                    ⚠️ Payment has been made for the booking; the matter of a refund must be addressed separately.
                </div>
                <group>
                    <field name="reservation_id"/>
                    <field name="reason" placeholder="გთხოვთ,შეიყვანეთ გაუქმების მიზეზი"/>
                </group>
                  <footer>
                        <button name="action_confirm_cancel" type="object" class="btn-primary" string="Confirm Cancellation"/>
                        <button special="cancel" class="btn-secondary" string="Close"/>
                    </footer>
            </form>
        </field>

    </record>
</odoo>