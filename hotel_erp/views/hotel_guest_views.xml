<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view -->
    <record id="hotel_guest_tree_view" model="ir.ui.view">
        <field name="name">hotel.guest.tree.view</field>
        <field name="model">hotel.guest</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="personal_number"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <!-- form view -->
    <record id="hotel_guest_form_view" model="ir.ui.view">
        <field name="name">hotel.guest.form.view</field>
        <field name="model">hotel.guest</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reservation" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="reservation_count" widget="statinfo" string="Reservations"/>
                        </button>
                    </div>
                    <group>
                        <group name="Guest_info" string="Guest Information">
                            <field name="name"/>
                            <field name="personal_number"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                        <group name="reservation" string="Reservations">
                            <!-- 🛑 ამოღებულია პრობლემური context="{'default_guest_id':id}" -->
                            <field name="reservation_ids"/>
                        </group>
                    </group>
                </sheet>
                <!-- 💬 Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- window action-->
    <record id="hotel_guest_window_action" model="ir.actions.act_window">
        <field name="name">Guest</field>
        <field name="res_model">hotel.guest</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>