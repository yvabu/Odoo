<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hotel_erp_payment_form_view" model="ir.ui.view">
        <field name="name">account.payment.advance.form</field>
        <field name="model">account.payment</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Prepayment / Deposit">
                <sheet>
                    <group>
                        <group>
                            <field name="payment_type" widget="radio"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="memo"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="payment_method_line_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" name="action_post" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>

                </footer>

            </form>
        </field>

    </record>
</odoo>