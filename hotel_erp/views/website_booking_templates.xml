<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- 1. BOOKING FORM TEMPLATE -->
    <template id="hotel_booking_form_page" name="Hotel Booking Form">
        <t t-call="website.layout">
            <head>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"/>
                <link rel="stylesheet" type="text/css" href="/hotel_erp/static/src/css/flatpickr_custom.css"/>
                <link rel="stylesheet" type="text/css" href="/hotel_erp/static/src/css/hotel_theme.css"/>
            </head>

            <div id="wrap" class="hx-page oe_structure oe_empty">
                <div class="hx-container" style="padding-top:48px;padding-bottom:80px">

                    <div class="text-center mb-4">
                        <h1 class="hx-title">Complete your reservation</h1>
                        <p class="hx-sub mx-auto">Please fill in your details to secure your stay.</p>
                    </div>

                    <t t-if="request.params.get('error')">
                        <div class="hx-alert hx-alert-bad" style="max-width:760px;margin:0 auto 24px">
                            <i class="fa fa-exclamation-triangle"/>
                            <span>
                                <t t-if="request.params.get('error') == 'email_required'">Email is required.</t>
                                <t t-elif="request.params.get('error') == 'room_unavailable'">This room is occupied for the selected dates..</t>
                                <t t-else=""><t t-out="request.params.get('error')"/></t>
                            </span>
                        </div>
                    </t>
                    <div class="hx-steps">
                        <div class="hx-step done"><b><i class="fa fa-check"/></b> Choose room</div>
                        <span class="hx-step-line"/>
                        <div class="hx-step on"><b>2</b> Your details</div>
                        <span class="hx-step-line"/>
                        <div class="hx-step"><b>3</b> Confirmation</div>
                    </div>

                    <div class="hx-booking">

                        <!-- LEFT: FORM -->
                        <div class="hx-form">

                            <t t-if="is_public">
                                <div class="hx-note info">
                                    <i class="fa fa-info-circle mt-1"/>
                                    <span>A personal account will be automatically created using your details; after check-in, you will be able to view your invoice and make an online payment.</span>
                                </div>
                            </t>
                            <t t-if="is_staff">
                                <div class="hx-note warn">
                                    <i class="fa fa-user-plus mt-1"/>
                                    <span>Booking on behalf of a guest — enter the guest's details (not your own).</span>
                                </div>
                            </t>

                            <form action="/booking/submit" method="post" id="booking_form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <div class="hx-fs">
                                    <h4 class="hx-fs-title"><i class="fa fa-user"/> Guest details</h4>
                                    <div class="hx-fgrid">
                                        <div>
                                            <label class="hx-label">Full name *</label>
                                            <input type="text" name="guest_name" class="hx-input"
                                                   placeholder="Guest's Full Name" required="1"
                                                   t-att-value="user.name if is_self_service else None"
                                                   t-att-readonly="'readonly' if is_self_service else None"/>
                                        </div>
                                        <div>
                                            <label class="hx-label">Personal ID / Passport *</label>
                                            <input type="text" id="personal_number" name="personal_number" class="hx-input"
                                                   placeholder="01219854892" maxlength="11" required="1"
                                                   t-att-value="guest.personal_number if is_self_service else None"
                                                   t-att-readonly="'readonly' if is_self_service else None"/>
                                            <div id="personal_number_error" class="hx-err"></div>
                                        </div>
                                        <div>
                                            <label class="hx-label">Email address *</label>
                                            <input type="email" id="email" name="email" class="hx-input"
                                                   placeholder="guest@example.com" required="1"
                                                   t-att-value="user.email if is_self_service else None"
                                                   t-att-readonly="'readonly' if is_self_service else None"/>
                                            <t t-if="is_public">
                                                <small class="hx-hint">This will be your login — for accessing your account.</small>
                                            </t>
                                            <div id="email_error" class="hx-err"></div>
                                        </div>
                                        <div>
                                            <label class="hx-label">Phone number *</label>
                                            <input type="tel" name="phone" id="phone" class="hx-input"
                                                   placeholder="551234567" maxlength="9" required="1"
                                                   t-att-value="user.phone if is_self_service else ''"/>
                                            <div id="phone_error" class="hx-err"></div>
                                        </div>
                                        <div class="hx-full">
                                            <label class="hx-label">Address *</label>
                                            <input type="text" name="address" class="hx-input"
                                                   placeholder="Street, City, Country" required="1"
                                                   t-att-value="user.partner_id.street if is_self_service else ''"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="hx-fs">
                                    <h4 class="hx-fs-title"><i class="fa fa-bed"/> Stay and room</h4>
                                    <div class="hx-fgrid">
                                        <div class="hx-full">
                                            <label class="hx-label">Selected room *</label>
                                            <input t-if="selected_room" type="hidden" name="room_id" t-att-value="selected_room.id"/>
                                            <select id="room_id" name="room_id" class="hx-input"
                                                    t-att-disabled="'disabled' if selected_room else None" required="1">
                                                <t t-if="selected_room">
                                                    <option t-att-value="selected_room.id" t-att-data-price="selected_room.room_price" selected="selected">
                                                        Room <t t-out="selected_room.room_number"/> — $<t t-out="selected_room.room_price"/> / night (<t t-out="selected_room.room_type"/>)
                                                    </option>
                                                </t>
                                                <t t-else="">
                                                    <option value="" disabled="1" selected="selected">Choose a room...</option>
                                                    <t t-foreach="rooms" t-as="r">
                                                        <option t-att-value="r.id" t-att-data-price="r.room_price">
                                                            Room <t t-out="r.room_number"/> — $<t t-out="r.room_price"/> / night (<t t-out="r.room_type"/>)
                                                        </option>
                                                    </t>
                                                </t>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="hx-label">Check-in date *</label>
                                            <input type="text" name="check_in" id="check_in" class="hx-input"
                                                   placeholder="Select check-in" autocomplete="off"
                                                   t-att-value="check_in" t-att-data-prefill="check_in" required="1"/>
                                        </div>
                                        <div>
                                            <label class="hx-label">Check-out date *</label>
                                            <input type="text" name="check_out" id="check_out" class="hx-input"
                                                   placeholder="Select check-out" autocomplete="off"
                                                   t-att-value="check_out" t-att-data-prefill="check_out" required="1"/>
                                        </div>
                                    </div>
                                </div>

                                <button type="submit" class="hx-btn hx-btn-gold hx-submit">
                                    Confirm reservation <i class="fa fa-arrow-right"/>
                                </button>
                            </form>
                        </div>

                        <!-- RIGHT: SUMMARY -->
                        <aside class="hx-sum">
                            <t t-if="selected_room">
                                <t t-set="carousel_id" t-value="'hxBookingCarousel_%s' % selected_room.id"/>
                                <t t-set="has_main_image" t-value="bool(selected_room.image_1920)"/>
                                <t t-set="photo_count" t-value="len(selected_room.image_ids) + (1 if has_main_image else 0)"/>

                                <div class="hx-sum-card">
                                    <!-- CAROUSEL START -->
                                    <div t-att-id="carousel_id"
                                         class="carousel slide hx-card-carousel"
                                         data-bs-ride="carousel"
                                         data-bs-interval="4000">

                                        <div class="carousel-inner">
                                            <!-- MAIN IMAGE -->
                                            <t t-if="selected_room.image_1920">
                                                <div class="carousel-item active">
                                                    <a t-attf-href="/room/#{selected_room.id}" class="hx-card-image-link">
                                                        <img t-attf-src="/web/image/hotel.room/#{selected_room.id}/image_1920"
                                                             t-att-alt="selected_room.room_number"
                                                             class="hx-card-image"
                                                             loading="lazy"/>
                                                    </a>
                                                </div>
                                            </t>

                                            <!-- ADDITIONAL IMAGES -->
                                            <t t-foreach="selected_room.image_ids" t-as="photo">
                                                <div t-attf-class="carousel-item #{'active' if not has_main_image and photo_index == 0 else ''}">
                                                    <a t-attf-href="/room/#{selected_room.id}" class="hx-card-image-link">
                                                        <img t-attf-src="/web/image/hotel.room.images/#{photo.id}/image_1920"
                                                             t-att-alt="selected_room.room_number"
                                                             class="hx-card-image"
                                                             loading="lazy"/>
                                                    </a>
                                                </div>
                                            </t>

                                            <!-- NO IMAGE -->
                                            <t t-if="not photo_count">
                                                <div class="carousel-item active">
                                                    <div class="hx-card-ph">
                                                        <i class="fa fa-bed"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>

                                        <!-- ROOM TYPE TAG -->
                                        <span class="hx-tag">
                                            <t t-out="selected_room.room_type"/>
                                        </span>

                                        <!-- INDICATORS & CONTROLS -->
                                        <t t-if="photo_count &gt; 1">
                                            <div class="carousel-indicators hx-card-indicators">
                                                <t t-foreach="range(photo_count)" t-as="index">
                                                    <button type="button"
                                                            t-attf-data-bs-target="##{carousel_id}"
                                                            t-attf-data-bs-slide-to="#{index}"
                                                            t-att-class="'active' if index == 0 else ''"
                                                            t-att-aria-label="'Slide %s' % (index + 1)"/>
                                                </t>
                                            </div>

                                            <button class="carousel-control-prev hx-card-control"
                                                    type="button"
                                                    t-attf-data-bs-target="##{carousel_id}"
                                                    data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon" aria-hidden="true"/>
                                            </button>

                                            <button class="carousel-control-next hx-card-control"
                                                    type="button"
                                                    t-attf-data-bs-target="##{carousel_id}"
                                                    data-bs-slide="next">
                                                <span class="carousel-control-next-icon" aria-hidden="true"/>
                                            </button>
                                        </t>
                                    </div>
                                    <!-- CAROUSEL END -->

                                    <div class="hx-sum-body">
                                        <h3>Room <t t-out="selected_room.room_number"/></h3>
                                        <div class="hx-meta" style="margin-bottom:0">
                                            <span><i class="fa fa-users"/> <t t-out="selected_room.capacity"/> guests</span>
                                            <span t-if="selected_room.is_wifi"><i class="fa fa-wifi"/> Wi-Fi</span>
                                            <span t-if="selected_room.is_air_conditioning"><i class="fa fa-snowflake-o"/> A/C</span>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <div id="price_summary_box" class="hx-total d-none">
                                <div class="row-l"><span>Price per night</span><strong>$<span id="display_night_price">0</span></strong></div>
                                <div class="row-l"><span>Number of nights</span><strong><span id="display_nights_count">0</span> night(s)</strong></div>
                                <hr/>
                                <div class="row-t"><span>Total</span><b>$<span id="display_total_price">0</span></b></div>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>

            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    let checkInPicker, checkOutPicker;
                    const roomSelect = document.getElementById("room_id");

                    const personalNumber = document.getElementById('personal_number');
                    const email = document.getElementById('email');
                    const phone = document.getElementById('phone');

                    const personalNumberError = document.getElementById('personal_number_error');
                    const emailError = document.getElementById('email_error');
                    const phoneError = document.getElementById('phone_error');

                    function showErr(el, msg) {
                        el.style.display = msg ? 'block' : 'none';
                        el.textContent = msg || '';
                    }

                    if (personalNumber) {
                        personalNumber.addEventListener("input", function () {
                            const value = this.value;
                            if (!/^\d*$/.test(value)) {
                                showErr(personalNumberError, "The personal number must contain only digits.");
                            } else if (value.length &gt; 0 &amp;&amp; value.length !== 11) {
                                showErr(personalNumberError, "The personal number must consist of 11 digits.");
                            } else {
                                showErr(personalNumberError, '');
                            }
                        });
                    }

                    if (email) {
                        email.addEventListener("input", function () {
                            const value = this.value;
                            if (value.length &gt; 0 &amp;&amp; (!value.includes('@') || !value.includes('.'))) {
                                showErr(emailError, "The email must contain the '@' and '.' symbols.");
                            } else {
                                showErr(emailError, '');
                            }
                        });
                    }

                    if (phone) {
                        phone.addEventListener("input", function () {
                            const value = this.value;
                            if (!/^\d*$/.test(value)) {
                                showErr(phoneError, "The phone number must contain only digits.");
                            } else if (value.length &gt; 0 &amp;&amp; value.length !== 9) {
                                showErr(phoneError, "The phone number must consist of 9 digits.");
                            } else {
                                showErr(phoneError, '');
                            }
                        });
                    }

                    const priceBox = document.getElementById("price_summary_box");
                    const displayNightPrice = document.getElementById("display_night_price");
                    const displayNightsCount = document.getElementById("display_nights_count");
                    const displayTotalPrice = document.getElementById("display_total_price");

                    function calculateTotalPrice() {
                        const selectedOption = roomSelect.options[roomSelect.selectedIndex];
                        const roomPrice = selectedOption ? parseFloat(selectedOption.getAttribute("data-price") || 0) : 0;
                        const checkInDate = checkInPicker ? checkInPicker.selectedDates[0] : null;
                        const checkOutDate = checkOutPicker ? checkOutPicker.selectedDates[0] : null;

                        if (roomPrice &gt; 0) {
                            displayNightPrice.textContent = roomPrice.toFixed(2);
                            priceBox.classList.remove("d-none");
                        }
                        if (roomPrice &gt; 0 &amp;&amp; checkInDate &amp;&amp; checkOutDate &amp;&amp; checkOutDate &gt; checkInDate) {
                            const diffDays = Math.ceil(Math.abs(checkOutDate - checkInDate) / (1000 * 60 * 60 * 24));
                            displayNightsCount.textContent = diffDays;
                            displayTotalPrice.textContent = (diffDays * roomPrice).toFixed(2);
                        } else {
                            displayNightsCount.textContent = "1";
                            displayTotalPrice.textContent = roomPrice.toFixed(2);
                        }
                    }

                    function initPickers(disabledDates = []) {
                        if (checkInPicker) checkInPicker.destroy();
                        if (checkOutPicker) checkOutPicker.destroy();

                        const prefilledCheckIn = document.getElementById("check_in").getAttribute("data-prefill") || null;
                        const prefilledCheckOut = document.getElementById("check_out").getAttribute("data-prefill") || null;

                        checkOutPicker = flatpickr("#check_out", {
                            minDate: "today", dateFormat: "Y-m-d",
                            disable: disabledDates, defaultDate: prefilledCheckOut,
                            onChange: function () { calculateTotalPrice(); }
                        });

                        checkInPicker = flatpickr("#check_in", {
                            minDate: "today", dateFormat: "Y-m-d",
                            disable: disabledDates, defaultDate: prefilledCheckIn,
                            onChange: function (selectedDates) {
                                if (selectedDates.length &gt; 0) {
                                    let nextDay = new Date(selectedDates[0]);
                                    nextDay.setDate(nextDay.getDate() + 1);
                                    checkOutPicker.set("minDate", nextDay);
                                    if (checkOutPicker.selectedDates[0] &amp;&amp; checkOutPicker.selectedDates[0] &lt; nextDay) {
                                        checkOutPicker.clear();
                                    }
                                }
                                calculateTotalPrice();
                            }
                        });

                        if (prefilledCheckIn &amp;&amp; prefilledCheckOut) { calculateTotalPrice(); }
                    }

                    initPickers();

                    roomSelect.addEventListener("change", function () {
                        calculateTotalPrice();
                        const roomId = this.value;
                        if (!roomId) return;
                        fetch('/hotel/get_booked_dates', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ jsonrpc: "2.0", method: "call", params: { room_id: roomId } })
                        })
                        .then(response =&gt; response.json())
                        .then(data =&gt; { initPickers(data.result || []); });
                    });

                    if (roomSelect.value) {
                        roomSelect.dispatchEvent(new Event('change'));
                    }
                });
            </script>
        </t>
    </template>

    <!-- 2. BOOKING SUCCESS TEMPLATE -->
    <template id="hotel_booking_success_page" name="Booking Success Page">
        <t t-call="website.layout">
            <head>
                <link rel="stylesheet" type="text/css" href="/hotel_erp/static/src/css/hotel_theme.css"/>
            </head>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

            <div id="wrap" class="hx-page oe_structure oe_empty">
                <div class="hx-container" style="padding-top:56px;padding-bottom:88px">

                    <div class="hx-steps">
                        <div class="hx-step done"><b><i class="fa fa-check"/></b> Choose room</div>
                        <span class="hx-step-line"/>
                        <div class="hx-step done"><b><i class="fa fa-check"/></b> Your details</div>
                        <span class="hx-step-line"/>
                        <div class="hx-step on"><b>3</b> Confirmation</div>
                    </div>

                    <div class="hx-success">
                        <div class="hx-success-ic"><i class="fa fa-check"/></div>
                        <h1 class="hx-title">Reservation received</h1>
                        <p class="text-muted mb-0">
                            Thank you, <strong class="text-dark"><t t-out="reservation.guest_id.name"/></strong>.
                            Your booking has been saved with the status <strong class="text-dark"><t t-out="reservation.state"/></strong>.
                        </p>

                        <div class="hx-sumbox">
                            <h6>RESERVATION SUMMARY</h6>
                            <div class="hx-row"><span>Reservation ref</span><span class="text-dark"><t t-out="reservation.name"/></span></div>
                            <div class="hx-row"><span>Room</span><span class="text-dark"><t t-out="reservation.room_id.room_number"/> (<t t-out="reservation.room_id.room_type"/>)</span></div>
                            <div class="hx-row"><span>Check-in / out</span><span class="text-dark"><t t-out="reservation.check_in"/> → <t t-out="reservation.check_out"/></span></div>
                            <div class="hx-row tot"><span>Estimated total</span><b class="hx-serif">$<t t-out="reservation.total_price"/></b></div>
                        </div>

                        <p class="small text-muted mb-4">
                            <i class="fa fa-info-circle me-1"/> The invoice and payment method will appear after check-in — at the reception or on your dashboard.
                        </p>

                        <div class="hx-actions">
                            <t t-if="reservation.invoice_id">
                                <a t-attf-href="/my/invoices/#{reservation.invoice_id.id}?access_token=#{reservation.invoice_id.access_token}" class="hx-btn hx-btn-gold">
                                    <i class="fa fa-credit-card"/> Pay invoice now
                                </a>
                            </t>
                            <a t-attf-href="/report/pdf/hotel_erp.report_reservation_document/#{reservation.id}" target="_blank" class="hx-btn hx-btn-line">
                                <i class="fa fa-file-pdf-o"/> Download reservation PDF
                            </a>
                            <div class="d-flex gap-2">
                                <a href="/" class="hx-btn hx-btn-line w-100">Back to home</a>
                                <a href="/my/dashboard" class="hx-btn hx-btn-dark w-100">My dashboard</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    if (window.Swal) {
                        Swal.fire({
                            title: 'Reservation accepted! 🎉',
                            text: 'After check-in, an invoice will be automatically generated, and you will be able to make an online payment..',
                            icon: 'success',
                            confirmButtonText: 'Good',
                            confirmButtonColor: '#12233A'
                        });
                    }
                });
            </script>
        </t>
    </template>
</odoo>