<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_employee_form_view" model="ir.ui.view">
        <field name="name">hotel.employee.form.view</field>
        <field name="model">hotel.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="name"/>
                            <field name="surname"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="password"/>
                            <field name="phone"/>
                            <field name="role"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="hotel_employee_tree_view" model="ir.ui.view">
        <field name="name">hotel.employee.tree.view</field>
        <field name="model">hotel.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="name"/>
                <field name="surname"/>
                <field name="email"/>
                <field name="role"/>
            </list>
        </field>
    </record>

    <record id="hotel_employee_window_action" model="ir.actions.act_window">
        <field name="name">hotel.employee.window.action</field>
        <field name="res_model">hotel.employee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>