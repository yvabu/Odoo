<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="hotel_rooms_page" name="ALL Rooms">
        <t t-call="website.layout">
            <head>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"/>
                <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/material_blue.css"/>
                <link rel="stylesheet" type="text/css" href="/hotel_erp/static/src/css/flatpickr_custom.css"/>
            </head>

            <div id="wrap" class="oe_structure oe_empty">

                <!-- ============ AVAILABILITY SEARCH HEADER ============ -->
                <div class="bg-dark py-5 mb-5">
                    <div class="container">
                        <div class="text-center mb-4">
                            <h1 class="display-4 fw-bold text-white mb-2">All Available Rooms</h1>
                            <p class="text-white-50 fs-5">აირჩიეთ თარიღები — დაგანახებთ მხოლოდ იმ დღეებში თავისუფალ ოთახებს</p>
                        </div>

                        <form action="/rooms" method="get" id="availability_search_form">
                            <div class="row g-3 justify-content-center align-items-end bg-white rounded-4 shadow p-4 mx-auto" style="max-width: 800px;">
                                <div class="col-md-5">
                                    <label class="form-label fw-semibold text-secondary small text-uppercase">Check-In</label>
                                    <input type="text" name="check_in" id="search_check_in"
                                           class="form-control form-control-lg bg-light border-0"
                                           placeholder="Select date" t-att-value="check_in" autocomplete="off" required="1"/>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-semibold text-secondary small text-uppercase">Check-Out</label>
                                    <input type="text" name="check_out" id="search_check_out"
                                           class="form-control form-control-lg bg-light border-0"
                                           placeholder="Select date" t-att-value="check_out" autocomplete="off" required="1"/>
                                </div>
                                <div class="col-md-2 d-grid">
                                    <button type="submit" class="btn btn-warning btn-lg fw-bold rounded-3">
                                        <i class="fa fa-search"></i> ძებნა
                                    </button>
                                </div>
                            </div>
                        </form>

                        <t t-if="date_error">
                            <div class="alert alert-warning text-center mx-auto mt-3" style="max-width: 800px;">
                                <t t-if="date_error == 'checkout_before_checkin'">
                                    Check-out თარიღი უნდა იყოს Check-in-ზე გვიან.
                                </t>
                                <t t-else="">
                                    გთხოვთ სწორად აირჩიოთ თარიღები.
                                </t>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- ============ ROOM CARDS ============ -->
                <div class="container mb-5">

                    <t t-if="filtered">
                        <p class="text-muted mb-4">
                            <i class="fa fa-check-circle text-success me-1"></i>
                            <t t-out="len(hotel_rooms)"/> ოთახი ხელმისაწვდომია
                            <strong><t t-out="check_in"/></strong> — <strong><t t-out="check_out"/></strong> პერიოდში.
                        </p>
                    </t>

                    <t t-if="not hotel_rooms">
                        <div class="text-center py-5">
                            <i class="fa fa-bed fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">ამ თარიღებისთვის თავისუფალი ოთახი ვერ მოიძებნა</h4>
                            <p class="text-muted">სცადეთ სხვა თარიღები.</p>
                        </div>
                    </t>

                    <div class="row g-4">
                        <t t-foreach="hotel_rooms" t-as="ht_room">
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover position-relative">

                                    <!-- ოთახის ფოტო: თუ ატვირთულია hotel.room-ში, ვიყენებთ მას, თუ არა — placeholder -->
                                    <div class="position-relative overflow-hidden style-card-img-container">
                                        <t t-if="ht_room.image">
                                            <img t-attf-src="/web/image/hotel.room/#{ht_room.id}/image"
                                                 class="d-block w-100 h-100 object-fit-cover transition-zoom"
                                                 t-att-alt="ht_room.room_number"/>
                                        </t>
                                        <t t-else="">
                                            <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&amp;fit=crop&amp;w=800&amp;q=80"
                                                 class="d-block w-100 h-100 object-fit-cover transition-zoom" alt="Room"/>
                                        </t>
                                        <span class="position-absolute top-0 end-0 m-3 badge rounded-pill bg-dark bg-opacity-75 px-3 py-2 fs-6">
                                            $<t t-out="ht_room.room_price"/> / night
                                        </span>
                                    </div>

                                    <!-- Card Body -->
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h4 class="card-title fw-bold text-dark mb-0">
                                                Room <t t-out="ht_room.room_number"/>
                                            </h4>
                                            <span class="badge bg-info text-dark px-2 py-1"><t t-out="ht_room.room_type"/></span>
                                        </div>

                                        <ul class="list-unstyled text-muted my-3 flex-grow-1">
                                            <li class="mb-2"><i class="fa fa-users me-2 text-warning"></i>Capacity: <strong><t t-out="ht_room.capacity"/> guests</strong></li>
                                            <li class="mb-2" t-if="ht_room.is_wifi"><i class="fa fa-wifi me-2 text-primary"></i>Wi-Fi Included</li>
                                            <li class="mb-2" t-if="ht_room.is_air_conditioning"><i class="fa fa-snowflake-o me-2 text-primary"></i>Air Conditioning</li>
                                        </ul>

                                        <div class="d-flex gap-2 mt-auto">
                                            <a t-attf-href="/room/#{ht_room.id}?check_in=#{check_in}&amp;check_out=#{check_out}"
                                               class="btn btn-outline-dark rounded-3 flex-fill fw-semibold">
                                                Details
                                            </a>

                                            <!-- ყველასთვის ერთი და იგივე ბმული — public ვიზიტორისთვის ანგარიში
                                                 ავტომატურად შეიქმნება submit-ისას -->
                                            <a t-attf-href="/booking?room_id=#{ht_room.id}&amp;check_in=#{check_in}&amp;check_out=#{check_out}"
                                               class="btn btn-warning rounded-3 flex-fill fw-bold">
                                                Book Now
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- JS: flatpickr on the header search bar, auto-submits once both dates picked -->
            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    let ciPicker, coPicker;

                    coPicker = flatpickr("#search_check_out", {
                        minDate: "today",
                        dateFormat: "Y-m-d",
                        onChange: function (selectedDates) {
                            if (selectedDates.length &gt; 0 &amp;&amp; ciPicker.selectedDates.length &gt; 0) {
                                document.getElementById("availability_search_form").submit();
                            }
                        }
                    });

                    ciPicker = flatpickr("#search_check_in", {
                        minDate: "today",
                        dateFormat: "Y-m-d",
                        onChange: function (selectedDates) {
                            if (selectedDates.length &gt; 0) {
                                let nextDay = new Date(selectedDates[0]);
                                nextDay.setDate(nextDay.getDate() + 1);
                                coPicker.set("minDate", nextDay);
                                if (coPicker.selectedDates[0] &amp;&amp; coPicker.selectedDates[0] &lt; nextDay) {
                                    coPicker.clear();
                                }
                            }
                        }
                    });
                });
            </script>
        </t>
    </template>
</odoo>