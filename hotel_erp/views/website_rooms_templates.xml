<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="hotel_rooms_page" name="ALL Rooms">
        <t t-call="website.layout">
            <head>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"/>
                <link rel="stylesheet" type="text/css" href="/hotel_erp/static/src/css/hotel_theme.css"/>
            </head>

            <div id="wrap" class="hx-page oe_structure oe_empty">

                <section class="hx-search-head">
                    <div class="hx-container">
                        <h1>Available rooms</h1>
                        <p>Select dates — I will show you rooms available only on those days.</p>
                    </div>
                </section>

                <form action="/rooms" method="get" id="availability_search_form" class="hx-search">
                    <div class="hx-field">
                        <label for="search_check_in">CHECK-IN</label>
                        <input type="text" name="check_in" id="search_check_in" placeholder="Select date" t-att-value="check_in" autocomplete="off" required="1"/>
                    </div>
                    <div class="hx-field">
                        <label for="search_check_out">CHECK-OUT</label>
                        <input type="text" name="check_out" id="search_check_out" placeholder="Select date" t-att-value="check_out" autocomplete="off" required="1"/>
                    </div>
                    <button type="submit" class="hx-btn hx-btn-gold"><i class="fa fa-search"/> Search</button>
                </form>

                <section class="hx-section" style="padding-top:40px">
                    <div class="hx-container">

                        <t t-if="date_error">
                            <div class="alert alert-warning text-center">
                                <t t-if="date_error == 'checkout_before_checkin'">The check-out date must be later than the check-in date.</t>
                                <t t-else="">Please select the dates correctly.</t>
                            </div>
                        </t>

                        <t t-if="filtered">
                            <p class="text-muted mb-4">
                                <i class="fa fa-check-circle text-success me-1"/>
                                <t t-out="len(hotel_rooms)"/> The room is available.
                                <strong><t t-out="check_in"/></strong> — <strong><t t-out="check_out"/></strong> პერიოდში.
                            </p>
                        </t>

                        <t t-if="not hotel_rooms">
                            <div class="text-center py-5">
                                <i class="fa fa-bed fa-3x text-muted mb-3"/>
                                <h4>No room could be found for these dates.</h4>
                                <p class="text-muted">Try other dates.</p>
                            </div>
                        </t>

                        <div class="hx-grid">
                            <t t-foreach="hotel_rooms" t-as="room">
                                <t t-call="hotel_erp.hotel_room_card">
                                    <t t-set="r" t-value="room"/>
                                </t>
                            </t>
                        </div>
                    </div>
                </section>
            </div>

            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    var ciPicker, coPicker;
                    coPicker = flatpickr("#search_check_out", {
                        minDate: "today", dateFormat: "Y-m-d",
                        onChange: function (sel) {
                            if (sel.length &gt; 0 &amp;&amp; ciPicker.selectedDates.length &gt; 0) {
                                document.getElementById("availability_search_form").submit();
                            }
                        }
                    });
                    ciPicker = flatpickr("#search_check_in", {
                        minDate: "today", dateFormat: "Y-m-d",
                        onChange: function (sel) {
                            if (sel.length &gt; 0) {
                                var next = new Date(sel[0]);
                                next.setDate(next.getDate() + 1);
                                coPicker.set("minDate", next);
                                if (coPicker.selectedDates[0] &amp;&amp; coPicker.selectedDates[0] &lt; next) { coPicker.clear(); }
                                coPicker.open();
                            }
                        }
                    });
                });
            </script>
        </t>
    </template>
</odoo>