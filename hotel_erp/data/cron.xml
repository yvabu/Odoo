<odoo>
    <data noupdate="1">
        <record id="ir_cron_expire_pending_reservations" model="ir.cron">
            <field name="name">Hotel: Expire Pending Reservations</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_pending()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>

        </record>
    </data>
</odoo>