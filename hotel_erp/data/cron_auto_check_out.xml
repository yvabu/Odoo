<odoo>
    <data noupdate="0">
        <record id="ir_cron_auto_check_out_reservations" model="ir.cron">
            <field name="name">Hotel: Auto Check out System</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_checkout()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>